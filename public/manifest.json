{
  "manifest_version": 3,
  "name": "MiRequest",
  "version": "1.0",
  "description": "Chrome extension built with Vite + npm",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_width": 1000,
    "default_height": 500
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://cathedralplumbingtx.bamboohr.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://cathedralplumbingtx.bamboohr.com/app/time_off/requests/create"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["absence-template-miview.pdf", "pdf-lib.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
